# Database Configuration
DB_PASSWORD=<change-me-local-only>
DB_USERNAME=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prediction

# Server Configuration
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/api/v1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT Configuration
# Generate a strong random base64 key using: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Binance API Configuration
# WebSocket URI for ticker/kline streams
WS_BINACE_STREAM=wss://stream.binance.com:9443/stream?streams=btcusdt@ticker/ethusdt@ticker/bnbusdt@ticker/solusdt@ticker/adausdt@ticker
# REST API for single symbol price fetch
SYMBOL_PRICE_API=https://api.binance.com/api/v3/ticker/price?symbol=
# Base URL for Binance REST API
BINANCE_API_URL=https://api.binance.com

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
